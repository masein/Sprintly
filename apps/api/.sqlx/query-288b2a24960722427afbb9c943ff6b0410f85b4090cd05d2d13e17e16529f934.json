{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT n.kind    AS \"kind!: String\",\n               n.title   AS \"title!: String\",\n               n.body,\n               n.link,\n               n.user_id AS \"user_id!: Uuid\",\n               u.email   AS \"email!: String\"\n        FROM   notifications n\n        JOIN   users u ON u.id = n.user_id\n        WHERE  n.id = $1 AND u.deleted_at IS NULL\n        ",
