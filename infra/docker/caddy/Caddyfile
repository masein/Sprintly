# ─────────────────────────────────────────────────────────────────────────────
# Sprintly — Caddy config.
#
# Dev:  CADDY_DOMAIN=localhost  → plain HTTP on :80 (exposed as host :8080).
# Prod: CADDY_DOMAIN=your.tld   → automatic HTTPS via Let's Encrypt.
#
# Routes:
#   /api/*   → api:8081   (REST)
#   /ws      → api:8081   (WebSocket)
#   /*       → web:3000   (Next.js)
# ─────────────────────────────────────────────────────────────────────────────

{
    email {$CADDY_EMAIL}
    # In dev (CADDY_DOMAIN=localhost) we serve plain HTTP. The auto_https
    # global option is disabled when the site label resolves to localhost.
}

{$CADDY_DOMAIN}:80, {$CADDY_DOMAIN} {
    encode gzip zstd

    # Security headers. CSP intentionally permissive in dev — tightened in prod
    # once we know what scripts/images we actually load.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # WebSocket upgrade. Must live inside a handle block: Caddy runs `handle`
    # directives before bare `reverse_proxy` ones, so the catch-all handle
    # below was swallowing /ws (→ web:3000 → 404) and a top-level
    # `reverse_proxy @ws` never saw the request. No header matcher — /ws
    # serves nothing but the socket, and the api answers non-upgrade GETs
    # with a plain 4xx anyway.
    @ws path /ws /ws/*
    handle @ws {
        reverse_proxy api:8081
    }

    # API.
    handle /api/* {
        reverse_proxy api:8081
    }

    # MinIO (presigned attachment URLs), same as prod: the prefix is stripped
    # before proxying so the forwarded path matches what the API's SigV4
    # signer used (/<bucket>/<key>, no /s3). Dev routing through this keeps
    # dev/CI on the exact prod topology — a host+path signing bug shipped
    # precisely because they diverged.
    handle_path /s3/* {
        # Stored objects are user uploads served from the app's own origin.
        # `sandbox` gives any document rendered from here an opaque origin with
        # scripts disabled, so an uploaded .html/.svg can never act as the app
        # (read the CSRF cookie, call the API) — even if a Content-Type slips
        # through. Downloads and images are unaffected.
        header Content-Security-Policy "sandbox"
        header X-Content-Type-Options "nosniff"
        reverse_proxy minio:9000
    }

    # Frontend (catch-all).
    handle {
        # Content-Security-Policy for the app's pages. What it buys today:
        # no plugins/objects, no <base> hijack, forms post only to us, no
        # framing (clickjacking), and scripts/connections/fonts only from
        # our own origin — injected markup can't pull in a remote script or
        # beacon data to a third-party API. Origins allowed:
        #   - rsms.me: the Inter webfont stylesheet + font files;
        #   - img https:/data:/blob:: avatars and markdown images may be any
        #     https URL; charts and generated avatars use data:/blob:;
        #   - ws:/wss:: the realtime socket (older Safari doesn't treat
        #     'self' as covering ws/wss).
        # script-src still needs 'unsafe-inline' for Next.js' inline
        # bootstrap scripts; moving to per-request nonces (Next middleware)
        # is the follow-up that would make this a real XSS backstop.
        # If MINIO_PUBLIC_ENDPOINT is ever an absolute URL on another origin,
        # add that origin to connect-src (uploads) and img-src.
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://rsms.me; font-src 'self' data: https://rsms.me; img-src 'self' data: blob: https:; connect-src 'self' ws: wss:; worker-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        reverse_proxy web:3000
    }
}
