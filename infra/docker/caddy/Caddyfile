# ─────────────────────────────────────────────────────────────────────────────
# Sprintly — Caddy config.
#
# Dev:  CADDY_DOMAIN=localhost  → plain HTTP on :80 (exposed as host :8080).
# Prod: CADDY_DOMAIN=your.tld   → automatic HTTPS via Let's Encrypt.
#
# Routes:
#   /api/*   → api:8081   (REST)
#   /ws      → api:8081   (WebSocket)
#   /*       → web:3000   (Next.js)
# ─────────────────────────────────────────────────────────────────────────────

{
    email {$CADDY_EMAIL}
    # In dev (CADDY_DOMAIN=localhost) we serve plain HTTP. The auto_https
    # global option is disabled when the site label resolves to localhost.
}

{$CADDY_DOMAIN}:80, {$CADDY_DOMAIN} {
    encode gzip zstd

    # Security headers. CSP intentionally permissive in dev — tightened in prod
    # once we know what scripts/images we actually load.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # WebSocket upgrade. Must live inside a handle block: Caddy runs `handle`
    # directives before bare `reverse_proxy` ones, so the catch-all handle
    # below was swallowing /ws (→ web:3000 → 404) and a top-level
    # `reverse_proxy @ws` never saw the request. No header matcher — /ws
    # serves nothing but the socket, and the api answers non-upgrade GETs
    # with a plain 4xx anyway.
    @ws path /ws /ws/*
    handle @ws {
        reverse_proxy api:8081
    }

    # API.
    handle /api/* {
        reverse_proxy api:8081
    }

    # MinIO (presigned attachment URLs), same as prod: the prefix is stripped
    # before proxying so the forwarded path matches what the API's SigV4
    # signer used (/<bucket>/<key>, no /s3). Dev routing through this keeps
    # dev/CI on the exact prod topology — a host+path signing bug shipped
    # precisely because they diverged.
    handle_path /s3/* {
        reverse_proxy minio:9000
    }

    # Frontend (catch-all).
    handle {
        reverse_proxy web:3000
    }
}
