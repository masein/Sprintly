# ─────────────────────────────────────────────────────────────────────────────
# Sprintly — PRODUCTION env template (air-gapped host + private registry).
#
# Copy to `.env` ON THE SERVER and fill in. NEVER commit a real `.env`.
# Placeholders below are deliberately non-secret. The __GENERATE_ON_SERVER__
# values must be generated on the box with /dev/urandom — see
# docs/RUNBOOK-PROD.md (Alpine has no `openssl`).
#
# docker-compose.prod.yml reads these fail-fast: a missing/empty required var
# aborts `up`/`pull` with a named error rather than booting misconfigured.
# ─────────────────────────────────────────────────────────────────────────────

# --- Registry + image selection ---
# Host of the private registry every image is pulled from.
REGISTRY_HOST=docker.netixsystem.com
# Which tag to run. `latest` tracks the newest main build; pin to a specific
# `sha-xxxxxxx` (from the release workflow) for a reproducible deploy/rollback.
IMAGE_TAG=latest

# --- Ingress ---
# The single published port on the host (Caddy). 80 = plain HTTP.
SPRINTLY_HTTP_PORT=80
# The URL users actually hit (used for links in emails, OIDC redirect, etc.).
SPRINTLY_PUBLIC_URL=http://sprintly.internal
# Public base for attachment/download links. Same origin, proxied to MinIO.
MINIO_PUBLIC_ENDPOINT=http://sprintly.internal/s3

# --- Core app ---
SPRINTLY_ENV=prod
# First boot: leave true to register the first admin, then set false + redeploy.
SPRINTLY_OPEN_SIGNUP=true
RUST_LOG=info,sprintly_api=info,sqlx=warn,tower_http=info
# Run migrations automatically at API startup. Leave true unless you manage
# schema changes out of band.
SPRINTLY_AUTO_MIGRATE=true

# --- Postgres ---
POSTGRES_USER=sprintly
POSTGRES_PASSWORD=__GENERATE_ON_SERVER__
POSTGRES_DB=sprintly
# Must match the three vars above. Host is the compose service name `postgres`.
DATABASE_URL=postgres://sprintly:__GENERATE_ON_SERVER__@postgres:5432/sprintly

# --- Redis (internal; no auth needed on the private network) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=sprintly
MINIO_ROOT_PASSWORD=__GENERATE_ON_SERVER__
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sprintly
MINIO_REGION=us-east-1

# --- Auth / crypto secrets (GENERATE — see runbook) ---
# 64 random bytes, base64. Signs access tokens (HS256).
SPRINTLY_JWT_SECRET=__GENERATE_ON_SERVER__
# 32 random bytes, base64. App refuses to boot without a valid 32-byte key.
SPRINTLY_VAULT_MASTER_KEY=__GENERATE_ON_SERVER__
SPRINTLY_VAULT_KEY_VERSION=1

# Argon2id — tune so login takes ~250ms on this hardware.
SPRINTLY_ACCESS_TTL_SECS=900
SPRINTLY_REFRESH_TTL_SECS=2592000
SPRINTLY_ARGON2_M_COST_KIB=65536
SPRINTLY_ARGON2_T_COST=3
SPRINTLY_ARGON2_P_COST=1

# --- Email (transactional: password reset, invites) — OPTIONAL ---
# Leave SPRINTLY_SMTP_URL unset/empty and outbound mail is only LOGGED, not
# sent — password-reset and invite emails will NOT be delivered. To actually
# send, point it at a reachable SMTP server (note: an air-gapped box usually
# can't reach public SMTP — use an internal relay):
#   smtps://user:pass@smtp.internal:465   (implicit TLS)
#   smtp://user:pass@smtp.internal:587     (STARTTLS)
SPRINTLY_SMTP_URL=
SPRINTLY_MAIL_FROM=Sprintly <noreply@sprintly.internal>

# --- Web ---
NEXT_PUBLIC_APP_NAME=Sprintly
